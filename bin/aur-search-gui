#!/usr/bin/env python3
import sys
import os
import shutil
import subprocess
import urllib.request
import urllib.parse
import json
import threading
import re
from concurrent.futures import ThreadPoolExecutor

from PyQt6.QtWidgets import QApplication
from PyQt6.QtQml import QQmlApplicationEngine
from PyQt6.QtCore import QObject, pyqtSlot, pyqtProperty, pyqtSignal, QUrl, QTimer

SERP_DIR = os.path.expanduser("~/.local/share/serpantinum")
SERP_STATE = os.path.expanduser("~/.local/state/serpantinum")

def get_serpantinum_theme():
    colors = {
        "base": "#110d11",
        "mantle": "#1f1a1f",
        "crust": "#171217",
        "surface0": "#231e23",
        "surface1": "#2e282e",
        "surface2": "#393338",
        "text": "#eae0e7",
        "subtext0": "#cfc3cd",
        "subtext1": "#988d97",
        "mauve": "#e9b5ef",
        "blue": "#e9b5ef",
        "peach": "#f5b7b0",
        "green": "#d6c0d6",
        "red": "#ffb4ab",
        "yellow": "#524153"
    }
    colors_file = os.path.join(SERP_STATE, "qs_colors.json")
    if os.path.isfile(colors_file):
        try:
            with open(colors_file, "r", encoding="utf-8") as f:
                data = json.load(f)
                colors.update(data)
        except Exception:
            pass
    return colors

def get_sound_path(rel_path):
    candidates = [
        os.path.expanduser(f"~/.local/share/aur-gui/sounds/{rel_path}"),
        os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "assets", "sounds", rel_path),
        os.path.expanduser(f"~/.local/share/serpantinum/src/assets/sounds/{rel_path}")
    ]
    for p in candidates:
        if os.path.isfile(p):
            return p
    return None

def play_sfx(rel_path):
    sound_file = get_sound_path(rel_path)
    if sound_file:
        player = shutil.which("pw-play") or shutil.which("paplay") or shutil.which("aplay")
        if player:
            try:
                subprocess.Popen(
                    [player, sound_file],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL
                )
            except Exception:
                pass

def get_terminal_command(title, cmd_args):
    """Detect available terminal emulator and format execution command."""
    custom_term = os.environ.get("TERMINAL")
    terms_to_try = []
    if custom_term:
        terms_to_try.append(custom_term)

    terms_to_try.extend([
        "kitty",
        "alacritty",
        "ghostty",
        "konsole",
        "foot",
        "gnome-terminal",
        "ptyxis",
        "xfce4-terminal",
        "wezterm",
        "xterm",
        "x-terminal-emulator"
    ])

    for term in terms_to_try:
        term_bin = shutil.which(term)
        if term_bin:
            t = os.path.basename(term_bin)
            if t == "xdg-terminal-exec":
                return [term_bin, "--app-id=aur-installer-term", f"--title={title}", "--"] + cmd_args
            elif t == "kitty":
                return [term_bin, "--class=aur-installer-term", "-T", title, "-e"] + cmd_args
            elif t == "alacritty":
                return [term_bin, "--class", "aur-installer-term,aur-installer-term", "-T", title, "-e"] + cmd_args
            elif t == "ghostty":
                return [term_bin, "--class=aur-installer-term", f"--title={title}", "-e"] + cmd_args
            elif t == "konsole":
                return [term_bin, "-p", f"tabtitle={title}", "-e"] + cmd_args
            elif t == "foot":
                return [term_bin, "--app-id=aur-installer-term", "-T", title] + cmd_args
            elif t in ["gnome-terminal", "ptyxis"]:
                return [term_bin, "--title", title, "--"] + cmd_args
            elif t == "xfce4-terminal":
                return [term_bin, "-T", title, "-x"] + cmd_args
            elif t == "wezterm":
                return [term_bin, "start", "--class", "aur-installer-term"] + cmd_args
            elif t in ["xterm", "x-terminal-emulator"]:
                return [term_bin, "-title", title, "-e"] + cmd_args
            else:
                return [term_bin, "-e"] + cmd_args

    return cmd_args

def get_qml_path():
    script_dir = os.path.dirname(os.path.realpath(__file__))
    candidates = [
        os.path.expanduser("~/.local/share/aur-gui/Main.qml"),
        os.path.join(script_dir, "..", "qml", "Main.qml"),
        os.path.join(script_dir, "Main.qml")
    ]
    for c in candidates:
        if os.path.isfile(c):
            return c
    return os.path.expanduser("~/.local/share/aur-gui/Main.qml")

class AurBackend(QObject):
    resultsChanged = pyqtSignal()
    statusTextChanged = pyqtSignal()
    themeChanged = pyqtSignal()

    def __init__(self, app_instance):
        super().__init__()
        self.app = app_instance
        self._theme = get_serpantinum_theme()
        self._results = []
        self._status_text = "Ingresa al menos 2 caracteres para buscar en AUR..."
        self._installed_cache = []
        self._installed_loaded = False
        self._current_mode = "install"

        # Timer para debounce de búsqueda en AUR
        self._debounce_timer = QTimer()
        self._debounce_timer.setSingleShot(True)
        self._debounce_timer.setInterval(240)
        self._debounce_timer.timeout.connect(self._do_aur_search)
        self._pending_query = ""

        # Pre-cargar en segundo plano la lista de paquetes instalados
        threading.Thread(target=self._fetch_all_installed_in_background, daemon=True).start()

    def _fetch_all_installed_in_background(self):
        try:
            # 1. Paquetes foráneos / puros de AUR (pacman -Qm)
            foreign_set = set()
            try:
                foreign_out = subprocess.check_output(["pacman", "-Qmq"], text=True, stderr=subprocess.DEVNULL)
                foreign_set = set(foreign_out.strip().split())
            except Exception:
                pass

            # 2. Paquetes del repositorio omarchy (repositorio AUR precompilado)
            omarchy_set = set()
            try:
                omarchy_out = subprocess.check_output(["pacman", "-Sl", "omarchy"], text=True, stderr=subprocess.DEVNULL)
                for line in omarchy_out.strip().split("\n"):
                    if "[installed]" in line:
                        parts = line.split()
                        if len(parts) >= 2:
                            omarchy_set.add(parts[1])
            except Exception:
                pass

            # 3. Todos los paquetes instalados explícitamente (pacman -Qe)
            explicit_out = subprocess.check_output(["pacman", "-Qe"], text=True, stderr=subprocess.DEVNULL)
            names = []
            pkgs = []
            for line in explicit_out.strip().split("\n"):
                if not line.strip():
                    continue
                parts = line.split()
                if len(parts) >= 2:
                    name, ver = parts[0], parts[1]
                    names.append(name)
                    is_foreign = name in foreign_set
                    is_omarchy = name in omarchy_set

                    if is_foreign:
                        badge = "AUR"
                        priority = 0
                    elif is_omarchy:
                        badge = "AUR / omarchy"
                        priority = 1
                    else:
                        badge = "Oficial"
                        priority = 2

                    pkgs.append({
                        "name": name,
                        "version": ver,
                        "is_aur": is_foreign or is_omarchy,
                        "repo": badge,
                        "priority": priority,
                        "installed_size": "",
                        "description": ""
                    })

            # Consultar descripciones y tamaños en bloque con pacman -Qi
            if names:
                qi_out = subprocess.check_output(["pacman", "-Qi"] + names, text=True, stderr=subprocess.DEVNULL)
                curr_name = None
                desc_map = {}
                size_map = {}
                for line in qi_out.split("\n"):
                    if line.startswith("Name "):
                        curr_name = line.split(":", 1)[1].strip()
                    elif line.startswith("Description ") and curr_name:
                        desc_map[curr_name] = line.split(":", 1)[1].strip()
                    elif line.startswith("Installed Size ") and curr_name:
                        size_map[curr_name] = line.split(":", 1)[1].strip()

                for p in pkgs:
                    p["description"] = desc_map.get(p["name"], "Sin descripción disponible")
                    p["installed_size"] = size_map.get(p["name"], "")

            # Ordenar: AUR primero, luego Omarchy, luego oficiales
            pkgs.sort(key=lambda x: (x["priority"], x["name"].lower()))
            self._installed_cache = pkgs
            self._installed_loaded = True

            if self._current_mode == "uninstall":
                self._filter_installed(self._pending_query)
        except Exception:
            pass

    @pyqtProperty("QVariantMap", notify=themeChanged)
    def theme(self):
        return self._theme

    @pyqtProperty("QVariantList", notify=resultsChanged)
    def results(self):
        return self._results

    @pyqtProperty(str, notify=statusTextChanged)
    def statusText(self):
        return self._status_text

    @pyqtSlot()
    def playTypeSound(self):
        play_sfx("reusables/input/type.wav")

    @pyqtSlot()
    def playClickSound(self):
        play_sfx("reusables/clickbutton/click.wav")

    @pyqtSlot()
    def playSwitchSound(self):
        play_sfx("reusables/switch/sfx.wav")

    @pyqtSlot(int, result="QVariantMap")
    def getItem(self, index):
        if 0 <= index < len(self._results):
            return self._results[index]
        return {}

    @pyqtSlot(str, str)
    def setMode(self, mode, current_text):
        self._current_mode = mode
        self._pending_query = current_text
        if mode == "uninstall":
            if not self._installed_loaded:
                self._status_text = "Cargando paquetes instalados..."
                self.statusTextChanged.emit()
            else:
                self._filter_installed(current_text)
        else:
            self.search(current_text, False)

    def _filter_installed(self, filter_text):
        raw_q = filter_text.strip().lower()
        if not raw_q:
            filtered = list(self._installed_cache)
        else:
            words = [w for w in re.split(r"[\s\-_]+", raw_q) if w]
            hyphenated = "-".join(words)

            def match_installed(p):
                name = p["name"].lower()
                desc = p.get("description", "").lower()
                if raw_q in name or hyphenated in name:
                    return True
                if all(w in name or w in desc for w in words):
                    return True
                return False

            filtered = [p for p in self._installed_cache if match_installed(p)]

            def sort_installed(p):
                name = p["name"].lower()
                if name == hyphenated or name == raw_q:
                    return (0, name)
                if name.startswith(hyphenated) or name.startswith(raw_q):
                    return (1, name)
                if all(w in name for w in words):
                    return (2, name)
                return (3, name)

            filtered.sort(key=sort_installed)

        self._results = filtered
        count = len(filtered)
        if raw_q:
            self._status_text = f"Mostrando {count} app(s) instalada(s) que coinciden con '{filter_text.strip()}':"
        else:
            aur_count = sum(1 for p in self._installed_cache if p["is_aur"])
            self._status_text = f"Mostrando {count} app(s) instalada(s) ({aur_count} de AUR / repos de usuario):"

        self.resultsChanged.emit()
        self.statusTextChanged.emit()

    @pyqtSlot(str, bool)
    def search(self, query, is_uninstall):
        query = query.strip()
        self._pending_query = query
        if is_uninstall:
            self._filter_installed(query)
            return

        if len(query) < 2:
            self._debounce_timer.stop()
            self._results = []
            self._status_text = "Ingresa al menos 2 caracteres para buscar en AUR..."
            self.resultsChanged.emit()
            self.statusTextChanged.emit()
            return

        self._status_text = f"Buscando '{query}' en AUR..."
        self.statusTextChanged.emit()
        self._debounce_timer.start()

    def _do_aur_search(self):
        query = self._pending_query

        def worker(q):
            raw_q = q.strip()
            words = [w for w in re.split(r"[\s\-_]+", raw_q.lower()) if w]
            if not words:
                return
            hyphenated = "-".join(words)
            compressed = "".join(words)

            urls = []
            if len(words) > 1:
                urls.append(f"https://aur.archlinux.org/rpc/v5/search/{urllib.parse.quote(hyphenated)}?by=name")
                urls.append(f"https://aur.archlinux.org/rpc/v5/search/{urllib.parse.quote(hyphenated)}")
                for w in words:
                    if len(w) >= 3:
                        urls.append(f"https://aur.archlinux.org/rpc/v5/search/{urllib.parse.quote(w)}?by=name")
            else:
                urls.append(f"https://aur.archlinux.org/rpc/v5/search/{urllib.parse.quote(raw_q)}")
                urls.append(f"https://aur.archlinux.org/rpc/v5/search/{urllib.parse.quote(raw_q)}?by=name")

            seen = set()
            combined = []

            def fetch_rpc(u):
                try:
                    req = urllib.request.Request(u, headers={"User-Agent": "aur-gui-serpantinum"})
                    with urllib.request.urlopen(req, timeout=4) as resp:
                        data = json.loads(resp.read().decode("utf-8"))
                        return data.get("results", [])
                except Exception:
                    return []

            with ThreadPoolExecutor(max_workers=5) as executor:
                for r_list in executor.map(fetch_rpc, urls):
                    for item in r_list:
                        name = item.get("Name", "")
                        if name and name not in seen:
                            seen.add(name)
                            combined.append({
                                "name": name,
                                "version": item.get("Version", ""),
                                "description": item.get("Description", "") or "Sin descripción",
                                "repo": "AUR",
                                "votes": item.get("NumVotes", 0),
                                "popularity": item.get("Popularity", 0.0),
                                "is_aur": True,
                                "installed_size": ""
                            })

            pacman_cmds = []
            if len(words) > 1:
                pacman_cmds.append(words)
                if hyphenated != words[0]:
                    pacman_cmds.append([hyphenated])
            else:
                pacman_cmds.append([raw_q])

            for p_args in pacman_cmds:
                try:
                    out = subprocess.check_output(["pacman", "-Ss"] + p_args, text=True, stderr=subprocess.DEVNULL)
                    lines = out.strip().split("\n")
                    i = 0
                    while i < len(lines):
                        line = lines[i].strip()
                        if not line:
                            i += 1
                            continue
                        parts = line.split()
                        if len(parts) >= 2 and "/" in parts[0]:
                            repo_and_name = parts[0].split("/")
                            repo = repo_and_name[0]
                            name = repo_and_name[1]
                            version = parts[1]
                            desc = ""
                            if i + 1 < len(lines) and lines[i + 1].startswith("    "):
                                desc = lines[i + 1].strip()
                                i += 1
                            if name and name not in seen:
                                seen.add(name)
                                combined.append({
                                    "name": name,
                                    "version": version,
                                    "description": desc or "Sin descripción",
                                    "repo": repo,
                                    "votes": 0,
                                    "popularity": 0.0,
                                    "is_aur": (repo == "omarchy"),
                                    "installed_size": ""
                                })
                        i += 1
                except Exception:
                    pass

            def score_pkg(pkg):
                name = pkg["name"].lower()
                desc = pkg.get("description", "").lower()
                score = 0

                # 1. Exact match
                if name == hyphenated or name == raw_q.lower() or name == compressed:
                    score += 200000
                elif name.startswith(hyphenated + "-") or name.startswith(raw_q.lower() + "-"):
                    score += 25000
                elif name.startswith(hyphenated) or name.startswith(raw_q.lower()):
                    score += 15000

                # 2. Token matches
                name_tokens = re.split(r"[\s\-_]+", name)
                matched_tokens = sum(1 for w in words if w in name_tokens)
                score += matched_tokens * 20000

                # 3. All words present in name
                all_words_in_name = all(w in name for w in words)
                if all_words_in_name:
                    score += 30000

                # 4. Description match
                if all(w in desc for w in words):
                    score += 5000

                # 5. Official repo bonus
                if not pkg.get("is_aur"):
                    if name == hyphenated or name == raw_q.lower() or name == compressed:
                        score += 80000
                    elif name.startswith(hyphenated) or name.startswith(raw_q.lower()):
                        score += 50000
                    elif all(w in name for w in words):
                        score += 35000
                    elif any(w in name for w in words):
                        score += 15000
                    else:
                        score += 5000

                # 6. AUR Votes & Popularity
                votes = pkg.get("votes", 0)
                pop = pkg.get("popularity", 0.0)
                if votes > 1000:
                    score += 60000
                elif votes > 300:
                    score += 40000
                elif votes > 50:
                    score += 20000
                elif votes > 10:
                    score += 10000
                elif votes > 0:
                    score += 3000

                score += min(votes * 15, 60000)
                score += min(int(pop * 2000), 30000)

                # Penalties for language packs / debug / docs
                if "-i18n-" in name or "-l10n-" in name or name.endswith("-i18n") or name.endswith("-l10n"):
                    score -= 40000
                if name.endswith("-debug") or name.endswith("-doc"):
                    score -= 20000

                # Penalty for excessively long names
                score -= min(len(name) * 50, 3000)
                return score

            combined.sort(key=score_pkg, reverse=True)

            try:
                if self._pending_query == q and self._current_mode == "install":
                    self._results = combined[:60]
                    if not self._results:
                        self._status_text = f"No se encontraron resultados para '{q}'."
                    else:
                        self._status_text = f"Mostrando {len(self._results)} paquetes para '{q}':"
                    self.resultsChanged.emit()
                    self.statusTextChanged.emit()
            except RuntimeError:
                pass

        t = threading.Thread(target=worker, args=(query,), daemon=True)
        t.start()

    @pyqtSlot(str, bool)
    def executeAction(self, pkg_name, is_uninstall):
        self.app.quit()

        action = "remove" if is_uninstall else "install"
        title = f"Desinstalando {pkg_name} - AUR" if is_uninstall else f"Instalando {pkg_name} - AUR"

        run_bin = shutil.which("aur-installer-run")
        if not run_bin:
            script_dir = os.path.dirname(os.path.realpath(__file__))
            cand = os.path.join(script_dir, "aur-installer-run")
            if os.path.isfile(cand) and os.access(cand, os.X_OK):
                run_bin = cand
            else:
                user_bin = os.path.expanduser("~/.local/bin/aur-installer-run")
                if os.path.isfile(user_bin):
                    run_bin = user_bin
                else:
                    run_bin = "aur-installer-run"

        cmd_args = [run_bin, action, pkg_name]
        term_cmd = get_terminal_command(title, cmd_args)

        try:
            subprocess.Popen(term_cmd)
        except Exception as e:
            subprocess.Popen(["notify-send", "-u", "critical", "Error al ejecutar terminal", str(e)])


def run_tui():
    """Modo fzf para terminal con soporte para yay y paru."""
    helper = shutil.which("yay") or shutil.which("paru")
    if not shutil.which("fzf") or not helper:
        print("Error: Se requieren 'fzf' y un helper de AUR ('yay' o 'paru').")
        sys.exit(1)

    helper_name = os.path.basename(helper)
    cmd = (
        f'{helper_name} -Pc | fzf --prompt="🔍 AUR/Repo > " '
        '--header="Enter: Instalar | Esc: Cancelar" '
        f'--preview="{helper_name} -Si {{1}} 2>/dev/null || pacman -Si {{1}}" '
        '--preview-window=right:60%:wrap'
    )
    res = subprocess.run(cmd, shell=True, text=True, capture_output=True)
    selected = res.stdout.strip().split()
    if selected:
        pkg = selected[0]
        subprocess.run(["aur-installer-run", "install", pkg])


def main():
    if "--cli" in sys.argv or "--tui" in sys.argv:
        run_tui()
        return

    app = QApplication(sys.argv)
    app.setDesktopFileName("aur-installer-gui")
    app.setApplicationName("aur-installer-gui")

    engine = QQmlApplicationEngine()
    backend = AurBackend(app)
    engine.rootContext().setContextProperty("backend", backend)

    qml_path = get_qml_path()
    engine.load(QUrl.fromLocalFile(qml_path))

    if not engine.rootObjects():
        print(f"Error: no se pudo cargar Main.qml desde {qml_path}")
        sys.exit(1)

    sys.exit(app.exec())


if __name__ == "__main__":
    main()
